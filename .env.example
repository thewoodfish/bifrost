# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- RPC endpoints ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# --- Attestcoin ---
# Sepolia's chainKey on CC3. The only source chain confirmed working.
CHAIN_KEY=1
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Deploy wiring ---
# Set after the Sepolia deploy; required by DeployCreditcoin and the SDK.
ORIGIN_VAULT=
# Set after the Creditcoin deploy; required by the SDK.
POOL_ENGINE=
# Optional role overrides; all default to the broadcasting account.
ADMIN=
ORIGINATOR=
VALUER=
# Optional: reuse an existing token instead of deploying TestUSDC.
STABLECOIN=
POOL_LIQUIDITY=10000000000000

# --- Verification (optional) ---
ETHERSCAN_API_KEY=

# --- Proof pipeline tuning (optional; defaults are fine) ---
# The prover can still 422 for a few seconds after the height reads as attested
# on-chain. buildProof retries transient failures inside this window rather than
# discarding the 8-20 min attestation wait that just completed.
PROOF_RETRY_TIMEOUT_MS=180000
PROOF_RETRY_POLL_MS=10000

# --- Signer ---
# Do NOT put a private key here. Use an encrypted keystore instead:
#   cast wallet import bifrost --interactive
# then pass --account bifrost to forge script.
#
# The SDK reads the same keystore. Set the account name and its password:
KEYSTORE_ACCOUNT=bifrost
KEYSTORE_PASSWORD=

# Separate valuer key, so the borrower cannot price its own collateral.
# Falls back to the borrower key when unset (local testing only).
VALUER_KEYSTORE_ACCOUNT=
VALUER_KEYSTORE_PASSWORD=
# PRIVATE_KEY is supported as a CI fallback only.
